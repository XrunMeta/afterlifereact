# .easignore — EAS Build 에 업로드 제외 목록.
# 존재하면 .gitignore 대신 이 파일이 사용됨.
# .gitignore 와 동일하게 두되, Firebase 설정 파일은 EXPO 빌드에 필요하므로
# 제외 목록에서 빼서(=포함되도록) 한다.
# (참고: firebase-service-account.json 은 EAS credentials 에 따로 업로드
#  되어 있으므로 빌드 컨텍스트에 포함시킬 필요 없음.)

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Firebase admin SDK 비공개 키 — 빌드 컨텍스트엔 절대 포함 금지
# (FCM 푸시 발송용. 앱에는 안 들어감. EAS credentials 통해 서버에서만 사용.)
firebase-service-account.json
*-firebase-adminsdk-*.json
GoogleService-Info.plist

# ⚠️ NOTE: google-services.json 은 의도적으로 제외 *안* 함.
# app.json 의 android.googleServicesFile 가 가리키는 파일이라 빌드 시 필요.
# (.gitignore 엔 있지만 .easignore 엔 없음.)

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
