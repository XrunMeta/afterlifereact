 project(VisionCameraResizePlugin)
 cmake_minimum_required(VERSION 3.9.0)
 
+# 16KB page size support (Google Play requirement for Android 15+).
+# Force 16KB ELF segment alignment on all shared libs built here
+# (libVisionCameraResizePlugin.so + libyuv.so from add_subdirectory below).
+set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,-z,max-page-size=16384")
+
