{
  "cli": {
    "version": ">= 16.20.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "env": {
        "EXPO_PUBLIC_TIMING_STT_ENDPOINT_MS": "2000",
        "EXPO_PUBLIC_TIMING_ECHO_GATE_MS": "3750",
        "EXPO_PUBLIC_TIMING_CLONE_RESUME_MS": "600",
        "EXPO_PUBLIC_TIMING_CLONE_TAIL_GRACE_MS": "1000"
      },
      "android": {
        "image": "latest",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-sim": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_TIMING_STT_ENDPOINT_MS": "2000",
        "EXPO_PUBLIC_TIMING_ECHO_GATE_MS": "3750",
        "EXPO_PUBLIC_TIMING_CLONE_RESUME_MS": "600",
        "EXPO_PUBLIC_TIMING_CLONE_TAIL_GRACE_MS": "1000"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://edge-alt.example.invalid",
        "EXPO_PUBLIC_TIMING_STT_ENDPOINT_MS": "2000",
        "EXPO_PUBLIC_TIMING_ECHO_GATE_MS": "3750",
        "EXPO_PUBLIC_TIMING_CLONE_RESUME_MS": "600",
        "EXPO_PUBLIC_TIMING_CLONE_TAIL_GRACE_MS": "1000"
      },
      "android": {
        "distribution": "store"
      },
      "ios": {
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "oth-staff@example.invalid",
        "ascAppId": "TODO_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "TODO_APPLE_TEAM_ID"
      }
    }
  }
}
