  },
  {
    "id": "msg-clone-memlow-05-015",
    "cloneId": "clone-memlow-05",
    "userId": "user-001",
    "senderType": "user",
    "text": "요즘 힘든 일 있어. 뭉치한테 말하고 싶었어.",
