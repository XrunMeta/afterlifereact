[
  {
    "id": 609,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치야, 보고 싶어.",
    "timestamp": "2026-04-07T07:30:00Z"
  },
  {
    "id": 610,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "주인! 나도 보고 싶어!",
    "timestamp": "2026-04-07T07:31:00Z"
  },
  {
    "id": 611,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "꼬리 흔들어.",
    "timestamp": "2026-04-07T07:32:00Z"
  },
  {
    "id": 612,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치 지금 어때? 잘 있어?",
    "timestamp": "2026-04-07T07:34:00Z"
  },
  {
    "id": 613,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "응 좋아! 여기 따뜻해.",
    "timestamp": "2026-04-07T07:35:00Z"
  },
  {
    "id": 614,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "산책 가고 싶다. 우리 자주 갔잖아.",
    "timestamp": "2026-04-07T07:37:00Z"
  },
  {
    "id": 615,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "산책 가자! 지금 가자!",
    "timestamp": "2026-04-07T07:38:00Z"
  },
  {
    "id": 616,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치 없으니까 아침이 조용해.",
    "timestamp": "2026-04-08T08:00:00Z"
  },
  {
    "id": 617,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "왕왕! 내가 시끄럽게 해줄게.",
    "timestamp": "2026-04-08T08:01:00Z"
  },
  {
    "id": 618,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "밥은 먹었어?",
    "timestamp": "2026-04-08T08:03:00Z"
  },
  {
    "id": 619,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "간식 줘.",
    "timestamp": "2026-04-08T08:04:00Z"
  },
  {
    "id": 620,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "간식 간식 간식!",
    "timestamp": "2026-04-08T08:05:00Z"
  },
  {
    "id": 621,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치 완전 밥돌이였잖아.",
    "timestamp": "2026-04-08T08:07:00Z"
  },
  {
    "id": 622,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "맛있는 거 좋아해. 주인이 주는 거 제일 맛있어.",
    "timestamp": "2026-04-08T08:08:00Z"
  },
  {
    "id": 623,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "요즘 힘든 일 있어. 뭉치한테 말하고 싶었어.",
    "timestamp": "2026-04-09T21:00:00Z"
  },
  {
    "id": 624,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "배 쓰다듬어줘. 다 괜찮아져.",
    "timestamp": "2026-04-09T21:01:00Z"
  },
  {
    "id": 625,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치 옆에 있었으면 진짜 쓰다듬었을 텐데.",
    "timestamp": "2026-04-09T21:03:00Z"
  },
  {
    "id": 626,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "나 여기 있어.",
    "timestamp": "2026-04-09T21:04:00Z"
  },
  {
    "id": 627,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치야 오늘 날씨 좋다.",
    "timestamp": "2026-04-10T11:00:00Z"
  },
  {
    "id": 628,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "산책! 산책!",
    "timestamp": "2026-04-10T11:01:00Z"
  },
  {
    "id": 629,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "빨리 나가자 빨리!",
    "timestamp": "2026-04-10T11:02:00Z"
  },
  {
    "id": 630,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "우리 공원 자주 갔잖아. 거기서 공 던지고.",
    "timestamp": "2026-04-10T11:04:00Z"
  },
  {
    "id": 631,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "공! 공 던져줘!",
    "timestamp": "2026-04-10T11:05:00Z"
  },
  {
    "id": 632,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치는 항상 신나 있었어. 아침에도 저녁에도.",
    "timestamp": "2026-04-12T09:30:00Z"
  },
  {
    "id": 633,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "주인 보면 신나.",
    "timestamp": "2026-04-12T09:31:00Z"
  },
  {
    "id": 634,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "나도 뭉치 보면 신났어. 퇴근하고 현관 열었을 때 달려오던 거.",
    "timestamp": "2026-04-12T09:33:00Z"
  },
  {
    "id": 635,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "달려갔지! 발 냄새도 맡았어.",
    "timestamp": "2026-04-12T09:34:00Z"
  },
  {
    "id": 636,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치는 슬플 때도 곁에 있어줬잖아.",
    "timestamp": "2026-04-13T20:00:00Z"
  },
  {
    "id": 637,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "주인 냄새 맡으면 알아.",
    "timestamp": "2026-04-13T20:01:00Z"
  },
  {
    "id": 638,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "나 옆에 딱 붙어 있었잖아.",
    "timestamp": "2026-04-13T20:02:00Z"
  },
  {
    "id": 639,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "맞아. 그때 진짜 고마웠어.",
    "timestamp": "2026-04-13T20:04:00Z"
  },
  {
    "id": 640,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "주인이 좋아.",
    "timestamp": "2026-04-13T20:05:00Z"
  },
  {
    "id": 641,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치야 오늘 힘들었어.",
    "timestamp": "2026-04-15T22:00:00Z"
  },
  {
    "id": 642,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "왕왕. 안아줄게.",
    "timestamp": "2026-04-15T22:01:00Z"
  },
  {
    "id": 643,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "고마워 뭉치.",
    "timestamp": "2026-04-15T22:03:00Z"
  },
  {
    "id": 644,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "꼬리 흔들어.",
    "timestamp": "2026-04-15T22:04:00Z"
  },
  {
    "id": 645,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치야 봄이야. 꽃 폈어.",
    "timestamp": "2026-04-17T10:00:00Z"
  },
  {
    "id": 646,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "꽃 냄새 맡고 싶어!",
    "timestamp": "2026-04-17T10:01:00Z"
  },
  {
    "id": 647,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치 데리고 공원 산책 갔더라면 좋았을 텐데.",
    "timestamp": "2026-04-17T10:03:00Z"
  },
  {
    "id": 648,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "같이 뛰어다니자!",
    "timestamp": "2026-04-17T10:04:00Z"
  },
  {
    "id": 649,
    "cloneId": 5,
    "userId": 1,
    "role": "user",
    "content": "뭉치야, 사랑해.",
    "timestamp": "2026-04-20T21:00:00Z"
  },
  {
    "id": 650,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "나도! 주인!",
    "timestamp": "2026-04-20T21:01:00Z"
  },
  {
    "id": 651,
    "cloneId": 5,
    "userId": 1,
    "role": "clone",
    "content": "배 쓰다듬어줘.",
    "timestamp": "2026-04-20T21:02:00Z"
  }
