  },
  {
    "id": "msg-clone-memlow-05-011",
    "cloneId": "clone-memlow-05",
    "userId": "user-001",
    "senderType": "clone",
    "text": "간식 줘.",
    "timestamp": "2026-04-08T08:04:00Z"
  },
  {
    "id": "msg-clone-memlow-05-012",
    "cloneId": "clone-memlow-05",
    "userId": "user-001",
    "senderType": "clone",
    "text": "간식 간식 간식!",
    "timestamp": "2026-04-08T08:05:00Z"
  },
  {
    "id": "msg-clone-memlow-05-013",
    "cloneId": "clone-memlow-05",
    "userId": "user-001",
    "senderType": "user",
    "text": "뭉치 완전 밥돌이였잖아.",
