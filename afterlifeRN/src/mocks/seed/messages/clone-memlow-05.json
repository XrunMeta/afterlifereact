  },
  {
    "id": "msg-clone-memlow-05-014",
    "cloneId": "clone-memlow-05",
    "userId": "user-001",
    "senderType": "clone",
    "text": "맛있는 거 좋아해. 주인이 주는 거 제일 맛있어.",
