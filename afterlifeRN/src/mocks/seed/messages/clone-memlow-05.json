  },
  {
    "id": "msg-clone-memlow-05-018",
    "cloneId": "clone-memlow-05",
    "userId": "user-001",
    "senderType": "clone",
    "text": "나 여기 있어.",
    "timestamp": "2026-04-09T21:04:00Z"
  },
  {
    "id": "msg-clone-memlow-05-019",
    "cloneId": "clone-memlow-05",
    "userId": "user-001",
    "senderType": "user",
    "text": "뭉치야 오늘 날씨 좋다.",
