{
  "name": "afterlifeapi",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply afterlife-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply afterlife-db --remote",
    "db:reset:local": "wrangler d1 execute afterlife-db --local --command=\"SELECT 1\" && rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local"
  },
  "keywords": [],
