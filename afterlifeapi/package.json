  "description": "",
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@simplewebauthn/server": "^13.3.0",
    "hono": "^4.12.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260402.1",
    "typescript": "^6.0.2",
    "wrangler": "^4.80.0"
  }
}
