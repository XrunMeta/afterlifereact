{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["index/**/*.ts", "lib/**/*", "flows/**/*.ts", "global-setup.ts", "../playwright.config.ts"],
  "exclude": ["lib/seed.mjs", "lib/d1-snapshot.mjs"]
}
