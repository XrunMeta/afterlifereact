{
  "name": "afterlife-root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:ids": "node --import tsx --test packages/test-ids/test/",
    "check:index": "tsx e2e-automation/lib/check-index.mjs",
    "test:lib": "node --import tsx --test e2e-automation/lib/test/",
    "typecheck": "tsc -p e2e-automation/tsconfig.json",
    "db:path": "node e2e-automation/lib/local-db.mjs",
    "db:sql": "node e2e-automation/lib/local-db.mjs",
    "db:snapshot": "node e2e-automation/lib/d1-snapshot.mjs",
    "db:seed": "node e2e-automation/lib/seed.mjs",
    "e2e:build-rn": "node --import tsx e2e-automation/lib/rn/build.mjs",
    "e2e:serve-rn": "node --import tsx e2e-automation/lib/rn/static-server.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
