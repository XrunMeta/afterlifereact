[Unit]
Description=afterlife MuseTalk inference (FastAPI, :8300)
After=network-online.target ollama-afterlife.service
Wants=network-online.target

[Service]
Type=simple
User=afterlife
Group=afterlife
WorkingDirectory=/home/afterlife/afterlife-server/musetalk-afterlife/source
Environment=PATH=/home/afterlife/miniconda3/envs/musetalk/bin:/usr/local/bin:/usr/bin:/bin
Environment=CUDA_VISIBLE_DEVICES=0
Environment=HOME=/home/afterlife
Environment=PYTHONPATH=/home/afterlife/afterlife-server/musetalk-afterlife/scripts
ExecStart=/home/afterlife/miniconda3/envs/musetalk/bin/uvicorn musetalk_server:app --host 127.0.0.1 --port 8300
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/afterlife/afterlife-server/musetalk-afterlife /home/afterlife/.cache /tmp
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=afterlife-musetalk

[Install]
WantedBy=multi-user.target
