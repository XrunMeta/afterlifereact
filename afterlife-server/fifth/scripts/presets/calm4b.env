# ─────────────────────────────────────────────────────────────
# fifth 입싱크 파라미터 프리셋 — calm4b
# ─────────────────────────────────────────────────────────────
# 체크포인트: 2026-06-15 KST · 히즈키 확정 (gominju + 실사진 bibap/its 테스트)
# 사용: PRESET=calm4b ./fifth_param_test.sh  (2장 입마스크 모드)
#       사진 1장: ./fifth_from_photo.sh (단일 모드, 같은 파라미터+눈깜빡임+머리스무딩)
# 수정: 이 파일 값만 바꾸면 됨 (`:=` 라 명령줄 env override 가 이 값보다 우선)
#
# 도달 경위 (요약):
#   입마스크 블렌드(얼굴/배경 단일=부들거림 없음) + closed_src affine 정렬
#   + JoyVASA 머리/표정 복원 + 차분 댐핑(cfg2.0/mult0.5) + 입 살짝 다묾(lip 0.24)
#   + idle 눈깜빡임 + 머리 흔들림 속도 완화(시간축 스무딩 3.5)
# 미해결/후속: 입 좌우 움직임, 실사진 일반화(Plan 3·사진2장 자동), JoyVASA 시드 고정
# ─────────────────────────────────────────────────────────────

# --- 움직임 (차분) ---
: "${CFG_SCALE:=2.0}"          # 머리/표정 강도(JoyVASA). 낮을수록 차분 (<1.5면 머리 굳음)
: "${DRIVING_MULT:=0.5}"       # 전체 motion 댐핑 배율
: "${LIP_OPEN:=0.24}"          # 입 최대 벌림 (작게=덜 벌림)

# --- 입싱크/닫힘 ---
: "${LIP_CLOSED:=0.0023}"      # 무음 닫힘(단일모드용. 입마스크 모드는 closed_src 담당)
: "${SIGMA:=1.0}"              # RMS 스무딩
: "${GAMMA:=1.0}"              # 입 반응 곡선
: "${OFFSET:=2}"               # 입싱크 보정(프레임)
: "${OPEN_SCALE:=1.0}"
: "${SILENCE:=0.05}"
: "${CDLIP_SMOOTH:=0}"
: "${CDLIP_SIGMA:=1.5}"
: "${FPS:=25}"

# --- 블렌드/정렬 (입마스크 + affine) ---
: "${BLEND_REGION:=mouth}"     # 입 영역만 블렌드 → 얼굴/배경 단일 → 부들거림 없음
: "${ALIGN_SOURCES:=1}"        # closed_src 정렬 on
: "${ALIGN_MODE:=affine}"      # 눈·코 landmark 정밀 정렬 (구도 일치)
: "${W_SIGMA:=1.0}"            # 블렌드 전환 스무딩
: "${MOUTH_DILATE:=28}"        # 입 마스크 크기(px)
: "${MOUTH_FEATHER:=22}"       # 입 마스크 경계 부드러움

# --- 눈 깜빡임 (idle) ---
: "${BLINK:=1}"                # 눈 깜빡임 on (JoyVASA c_eyes 부재 보완)
: "${BLINK_INTERVAL:=3.2}"     # 평균 간격(초)
: "${BLINK_DUR:=6}"            # 깜빡임 1회 프레임 수 (▲8=완전 감김)

# --- 머리 흔들림 속도 ---
: "${HEAD_SMOOTH:=3.5}"        # motion 시간축 스무딩(속도↓·진폭유지). 0=off · 3.5=천천히(속도-69%) · 5=더 느리게

# --- 입력 자산 (gominju 테스트. 실클론은 사진별 교체) ---
: "${SOURCE:=gominju_v2_mouth_rank1_f119.jpg}"   # open(치아 보임)
: "${CLOSED_SRC:=gominju_source.jpg}"            # closed(입다묾)
: "${WAV:=gominju_speech.wav}"
